@model NoteViewModel

<div class="card mb-2">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
            <h6 class="card-title">@Model.Title</h6>
            <form asp-controller="Notes" asp-action="Delete" asp-route-id="@Model.Id" method="post"
                  onsubmit="return confirm('Delete this note?');">
                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
            </form>
        </div>
        <p class="card-text" style="white-space: pre-line;">@Model.Text</p>
        <small class="text-muted">@Model.CreatedOn.ToString("dd MMM yyyy")</small>
    </div>
</div>