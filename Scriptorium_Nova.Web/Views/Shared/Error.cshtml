@model ErrorViewModel

@{
    ViewData["Title"] = "Something went wrong";
}

<div class="text-center py-5">
    <h1 class="display-4">Something went wrong</h1>
    <p class="text-muted">An unexpected error occurred while processing your request. Please try again.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to home</a>
</div>