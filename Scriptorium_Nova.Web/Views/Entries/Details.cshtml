@model EntryDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="mb-4">
    <span class="badge bg-secondary">@Model.EntryTypeName</span>
    <h1>@Model.Name</h1>
    <p class="lead">@Model.Summary</p>
    <p class="text-muted">Created on @Model.CreatedOn.ToString("dd MMM yyyy")</p>

    @if (!string.IsNullOrWhiteSpace(Model.Details))
    {
        <p style="white-space: pre-line;">@Model.Details</p>
    }

    <div class="d-flex gap-2">
        <a asp-controller="Entries" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit</a>
        <a asp-controller="Entries" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete</a>
        <a asp-controller="Entries" asp-action="Index" class="btn btn-link">Back to entries</a>
    </div>
</div>

<h2 id="notes">Notes (@Model.Notes.Count()/@EntityValidation.Note.MaxNotesPerEntry)</h2>

<partial name="_NoteForm" model="Model.NewNote" />

@if (!Model.Notes.Any())
{
    <p class="text-muted">No notes yet.</p>
}
else
{
    @foreach (NoteViewModel note in Model.Notes)
    {
        <partial name="_NoteItem" model="note" />
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}