@{
    ViewData["Title"] = "Page not found";
}

<div class="text-center py-5">
    <h1 class="display-1">404</h1>
    <h2 class="mb-3">This page is not in the Codex</h2>
    <p class="text-muted">The entry you are looking for does not exist, or it was deleted.</p>
    <div class="d-flex justify-content-center gap-2">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to home</a>
        <a asp-controller="Entries" asp-action="Index" class="btn btn-outline-secondary">Browse entries</a>
    </div>
</div>